
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# First admin account. Used later to seed users.is_admin.
# Iranian mobile, 11 digits, like 09121234567
ADMIN_PHONE=
ADMIN_PASSWORD=

CORS_ORIGINS=https://app.rasadbina.ir

# Kavenegar simple SMS (OTP). Leave API key empty for local test code 123456.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_MESSAGE=سامانه دیده‌بان فرهنگ\nکد ورود شما: {code}
# THREAD_POOL_SIZE=256
# RATE_LIMIT_ENABLED=1
