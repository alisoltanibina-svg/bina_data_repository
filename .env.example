
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# First admin account only. Existing admin credentials are never overwritten.
# Iranian mobile, 11 digits, like 09121234567
ADMIN_PHONE=
ADMIN_PASSWORD=

CORS_ORIGINS=https://app.rasadbina.ir

# Production build directory when Uvicorn also serves frontend files.
# STATIC_ROOT=/opt/app/dist

# Kavenegar: lookup OTP + simple SMS notices. Leave API key empty for local test code 123456.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=binaappotp
KAVENEGAR_SENDER=
# Cloudflare Turnstile login protection. Register a widget for this hostname first.
# TURNSTILE_ENABLED=1
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=app.rasadbina.ir
# THREAD_POOL_SIZE=256
# RATE_LIMIT_ENABLED=1
