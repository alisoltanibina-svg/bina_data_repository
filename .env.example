
DATABASE_URL=

# Browser-visible Neshan web map key. Restrict allowed domains in the Neshan panel.
NESHAN_MAP_API_KEY=

# First admin account only. Existing admin credentials are never overwritten.
# Iranian mobile, 11 digits, like 09121234567
ADMIN_PHONE=
ADMIN_PASSWORD=

CORS_ORIGINS=https://app.rasadbina.ir

# Production build directory when Uvicorn also serves frontend files.
# STATIC_ROOT=/opt/app/dist


KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

CAPTCHA_ENABLED=1
CAPTCHA_HMAC_SECRET=

# Private ticket images: outside both the project and the Nginx/static document root.
# TICKET_ATTACHMENT_DIR=

NESHAN_SERVICE_API_KEY=
# Separate server key with Nearby + POI Details access. Never exposed to the browser.
# Optional separate server key for Reverse Geocoding (/v5/reverse).
# If empty, NESHAN_SERVICE_API_KEY is used; enable Reverse Geocoding for that key.
# This is a service API key, not the browser-visible map key.
NESHAN_REVERSE_API_KEY=
NESHAN_NEARBY_RESULT_CAP=0
# Set only to a provider-confirmed limit; reaching it marks coverage for review.


# Confirm provider permission for authenticated-user aggregates and live Nearby display.
# This is separate from existing internal/admin collection approval.
NESHAN_EXPLORE_AUTHORIZED=false

# Minimum spacing across all live map requests; set to your account quota.
# Collector scheduling remains separate; actual provider backoff is shared.
NESHAN_EXPLORE_INTERVAL_SECONDS=1
# Browser discovery budgets; global server rate limits still apply.
NESHAN_EXPLORE_REQUESTS_PER_VIEW=2
NESHAN_EXPLORE_SESSION_REQUEST_LIMIT=120
NESHAN_EXPLORE_MEMORY_PLACES=5000
NESHAN_EXPLORE_CELL_TTL_SECONDS=900
