
DATABASE_URL=

# Browser-visible Neshan web map key. Restrict allowed domains in the Neshan panel.
NESHAN_MAP_API_KEY=

# First admin account only. Existing admin credentials are never overwritten.
# Iranian mobile, 11 digits, like 09121234567
ADMIN_PHONE=
ADMIN_PASSWORD=

CORS_ORIGINS=https://app.rasadbina.ir

# Production build directory when Uvicorn also serves frontend files.
# STATIC_ROOT=/opt/app/dist


KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=binaappotp
KAVENEGAR_SENDER=

CAPTCHA_ENABLED=1
CAPTCHA_HMAC_SECRET=

# Private ticket images: outside both the project and the Nginx/static document root.
# TICKET_ATTACHMENT_DIR=

NESHAN_SERVICE_API_KEY=
# Separate server key with Nearby + POI Details access. Never exposed to the browser.
NESHAN_NEARBY_RESULT_CAP=0
# Set only to a provider-confirmed limit; reaching it marks coverage for review.

