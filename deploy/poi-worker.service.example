[Unit]
Description=Dashboard Neshan POI acquisition worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
WorkingDirectory=/opt/app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/.venv/bin/python -m backend.poi_worker
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
