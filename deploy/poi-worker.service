[Unit]
Description=Bina Neshan POI collection
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/app
EnvironmentFile=/opt/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/app/venv/bin/python -m backend.poi_worker
Restart=always
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
